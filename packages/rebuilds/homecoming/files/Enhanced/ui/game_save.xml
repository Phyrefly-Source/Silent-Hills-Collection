	<!-- Homecoming Enhanced: Back and the load mode (pause menu > Load Game) -->
	<Controller Name="EnhBack">
		<ScriptTrigger ScriptFunctionName="EnhancedScript" ScriptMessage="Back:Save:Back"/>
	</Controller>
	<Controller Name="LeaveToPause">
		<ScreenChanger NewScreen="PauseScreen"/>
		<ScriptTrigger ScriptFunctionName="SaveGameScript" ScriptMessage="SaveLoadExitOSUI"/>
		<ScriptTrigger ScriptFunctionName="SaveGameScript" ScriptMessage="LeaveSaveGameScreen"/>
		<AdditionalTriggerItem>Back_Sound</AdditionalTriggerItem>
		<AdditionalTriggerItem>DisableCursor</AdditionalTriggerItem>
		<AdditionalTriggerItem>Foreground_DisableTwoButtons</AdditionalTriggerItem>
	</Controller>
	<PopupMessageTrigger Name="LoadVerify" TextTag="IDS_ENH_LOAD_CONFIRM" TriggerOnConfirmed="LoadConfirmed" TriggerOnDenied="LoadDenied">
		<AdditionalTriggerItem>Select_Sound</AdditionalTriggerItem>
		<ScriptTrigger ScriptFunctionName="SelectionAnimationScript" ScriptMessage="Deactivate"/>
	</PopupMessageTrigger>
	<Controller Name="LoadConfirmed">
		<GameResumeFreezeTrigger/>
		<AdditionalTriggerItem>DisableCursor</AdditionalTriggerItem>
		<AdditionalTriggerItem>Foreground_DisableTwoButtons</AdditionalTriggerItem>
		<ScriptTrigger ScriptFunctionName="EnhancedScript" ScriptMessage="Confirm:Save:Load"/>
	</Controller>
	<Controller Name="LoadDenied">
		<ScriptTrigger ScriptFunctionName="EnhancedScript" ScriptMessage="Deny:Save:Load"/>
	</Controller>

	<!-- Homecoming Enhanced: the quick-save row -->
	<Controller Name="QuickSlotOn">
		<ScriptTrigger ScriptFunctionName="SelectionAnimationScript" ScriptMessage="QuickSlotText"/>
