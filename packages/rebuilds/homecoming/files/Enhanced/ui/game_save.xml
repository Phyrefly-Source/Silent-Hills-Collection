	<Controller Name="EnterSaveGameScreen">
		<ScriptTrigger ScriptFunctionName="EnhancedScript" ScriptMessage="Update:Save"/>
	    <ScriptTrigger ScriptFunctionName="SaveGameScript" ScriptMessage="SaveLoadEnterOSUI"/>
	    <OnOffSwitch TargetScreenItem="SaveSlotList" TurnOn="false"/>
	    <AdditionalTriggerItem>EnableCursor</AdditionalTriggerItem>
	    <AdditionalTriggerItem>Foreground_EnableTwoButtons</AdditionalTriggerItem>
        <TextSwitcher TargetScreenItem="Foreground_FirstButton_Text" NewText="IDS_SHELL_SELECT"/>
        <IconChanger TargetScreenItem="Foreground_FirstButton_Icon" Command="COMMAND_UI_SELECT"/>
        <TextSwitcher TargetScreenItem="Foreground_SecondButton_Text" NewText="IDS_SHELL_BACK"/>
        <IconChanger TargetScreenItem="Foreground_SecondButton_Icon" Command="COMMAND_UI_BACK"/>
	</Controller>
	
	<Controller Name="LeaveSaveGameScreen">
		<ScreenChanger NewScreen="HUD"/>	
		<GameResumeFreezeTrigger/>
    <ScriptTrigger ScriptFunctionName="SaveGameScript" ScriptMessage="SaveLoadExitOSUI"/>
		<ScriptTrigger ScriptFunctionName="SaveGameScript" ScriptMessage="LeaveSaveGameScreen"/>
		<AdditionalTriggerItem>DisableCursor</AdditionalTriggerItem>
		<AdditionalTriggerItem>Foreground_DisableTwoButtons</AdditionalTriggerItem>
	</Controller>
	
	<Controller Name="ActivateSaveSlotList">
		<OnOffSwitch TargetScreenItem="SaveSlotList" TurnOn="true"/>		
	</Controller>

