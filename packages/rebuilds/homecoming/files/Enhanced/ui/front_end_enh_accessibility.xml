		<ScriptTrigger ScriptFunctionName="EnhancedScript" ScriptMessage="Inc:Accessibility:HitShake"/>
		<AdditionalTriggerItem>Select_Sound</AdditionalTriggerItem>
		<ScaleTimer Time="0.25" TargetScreenItem="HitShake_RightArrow_Selected" StartScale="1" EndScale="2" Interpolation="Sinewave"/>
		<AlphaTimer Time="0.25" TargetScreenItem="HitShake_RightArrow_Selected" StartAlpha="1" EndAlpha="0" Interpolation="SineWave" SetVisibleWhenStarted="true" SetInvisibleWhenFinished="true"/>
	</Controller>
	<Controller Name="DecHitShake">
		<ScriptTrigger ScriptFunctionName="EnhancedScript" ScriptMessage="Dec:Accessibility:HitShake"/>
		<AdditionalTriggerItem>Select_Sound</AdditionalTriggerItem>
		<ScaleTimer Time="0.25" TargetScreenItem="HitShake_LeftArrow_Selected" StartScale="1" EndScale="2" Interpolation="Sinewave"/>
		<AlphaTimer Time="0.25" TargetScreenItem="HitShake_LeftArrow_Selected" StartAlpha="1" EndAlpha="0" Interpolation="SineWave" SetVisibleWhenStarted="true" SetInvisibleWhenFinished="true"/>
	</Controller>

	<CursorHoverController TargetScreenItem="VibrationText" EnterTrigger="VibrationListenerOn"/>
	<CursorHoverController TargetScreenItem="Vibration_LeftArrow" EnterTrigger="VibrationListenerOn"/>
	<CursorHoverController TargetScreenItem="Vibration_RightArrow" EnterTrigger="VibrationListenerOn"/>
	<Controller Name="VibrationOn">
		<AlphaChanger TargetScreenItem="VibrationText" Alpha="1"/>
		<ScriptTrigger ScriptFunctionName="EnhancedScript" ScriptMessage="Focus:Accessibility:Vibration"/>
		<AlphaChanger TargetScreenItem="VibrationContainer" Alpha="1"/>
	</Controller>
	<Controller Name="VibrationOff">
		<AlphaChanger TargetScreenItem="VibrationText" Alpha="0.5"/>
		<AlphaChanger TargetScreenItem="VibrationContainer" Alpha="0.3"/>
	</Controller>

	<InputFocusChanger Name="VibrationListenerOn" NewFocus="VibrationListener"/>
	<Controller Name="NextVibration">
		<AdditionalTriggerItem>SubtitlesListenerOn</AdditionalTriggerItem>
		<AdditionalTriggerItem>Vertical_Sound</AdditionalTriggerItem>
	</Controller>
	<Controller Name="PrevVibration">
		<AdditionalTriggerItem>HitShakeListenerOn</AdditionalTriggerItem>
		<AdditionalTriggerItem>Vertical_Sound</AdditionalTriggerItem>
	</Controller>
	<InputListener Name="VibrationListener" OnLostInputFocus="VibrationOff" OnGainedInputFocus="VibrationOn">
		<InputTrigger TriggerItem="PrevVibration" TimeBetweenScans="0.250000" Command="COMMAND_UI_UP"/>
		<InputTrigger TriggerItem="NextVibration" TimeBetweenScans="0.250000" Command="COMMAND_UI_DOWN"/>
		<InputTrigger TriggerItem="PrevVibration" TimeBetweenScans="0.250000" Command="COMMAND_UI_STICK_UP"/>
		<InputTrigger TriggerItem="NextVibration" TimeBetweenScans="0.250000" Command="COMMAND_UI_STICK_DOWN"/>
		<InputTrigger TriggerItem="GoBack" TimeBetweenScans="0.250000" IgnoreUntilReleased="true" FlushStream="true" Command="COMMAND_UI_BACK"/>
		<InputTrigger TriggerItem="IncVibration" TimeBetweenScans="0.200000" Command="COMMAND_UI_RIGHT"/>
		<InputTrigger TriggerItem="DecVibration" TimeBetweenScans="0.200000" Command="COMMAND_UI_LEFT"/>
		<InputTrigger TriggerItem="IncVibration" TimeBetweenScans="0.200000" Command="COMMAND_UI_STICK_RIGHT"/>
		<InputTrigger TriggerItem="DecVibration" TimeBetweenScans="0.200000" Command="COMMAND_UI_STICK_LEFT"/>
		<InputTrigger TriggerItem="IncVibration" TimeBetweenScans="0.250000" IgnoreUntilReleased="true" FlushStream="true" Command="COMMAND_UI_SELECT"/>
		<InputTrigger TriggerItem="IncVibration" TimeBetweenScans="0.250000" Command="COMMAND_MOUSE_LEFT_CLICK" CursorBounds="Vibration_RightArrow"/>
		<InputTrigger TriggerItem="DecVibration" TimeBetweenScans="0.250000" Command="COMMAND_MOUSE_LEFT_CLICK" CursorBounds="Vibration_LeftArrow"/>
		<InputTrigger TriggerItem="IncVibration" TimeBetweenScans="0.250000" Command="COMMAND_MOUSE_LEFT_CLICK" CursorBounds="VibrationValue"/>
	</InputListener>

	<Controller Name="IncVibration">
		<ScriptTrigger ScriptFunctionName="EnhancedScript" ScriptMessage="Inc:Accessibility:Vibration"/>
		<AdditionalTriggerItem>Select_Sound</AdditionalTriggerItem>
		<ScaleTimer Time="0.25" TargetScreenItem="Vibration_RightArrow_Selected" StartScale="1" EndScale="2" Interpolation="Sinewave"/>
		<AlphaTimer Time="0.25" TargetScreenItem="Vibration_RightArrow_Selected" StartAlpha="1" EndAlpha="0" Interpolation="SineWave" SetVisibleWhenStarted="true" SetInvisibleWhenFinished="true"/>
	</Controller>
	<Controller Name="DecVibration">
		<ScriptTrigger ScriptFunctionName="EnhancedScript" ScriptMessage="Dec:Accessibility:Vibration"/>
		<AdditionalTriggerItem>Select_Sound</AdditionalTriggerItem>
		<ScaleTimer Time="0.25" TargetScreenItem="Vibration_LeftArrow_Selected" StartScale="1" EndScale="2" Interpolation="Sinewave"/>
		<AlphaTimer Time="0.25" TargetScreenItem="Vibration_LeftArrow_Selected" StartAlpha="1" EndAlpha="0" Interpolation="SineWave" SetVisibleWhenStarted="true" SetInvisibleWhenFinished="true"/>
	</Controller>

</Screen>
